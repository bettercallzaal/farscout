# Discord
DISCORD_TOKEN=
DISCORD_USER_ID=

# Models
OPENROUTER_API_KEY=
FREE_MODEL_IDS=openai/gpt-oss-120b:free,z-ai/glm-4.5-air:free,moonshotai/kimi-k2.6:free,nvidia/nemotron-3-super-120b-a12b:free,openai/gpt-oss-20b:free,meta-llama/llama-3.3-70b-instruct:free
OLLAMA_TUNNEL_URL=
OLLAMA_MODEL=llama3.1

# Themes: named bundles of channels + subreddits + standing topics per domain.
# Default covers BOTH farcaster and gamestop. Known: farcaster, gamestop.
# Pick a subset (e.g. THEMES=farcaster) or list your own. Explicit
# WATCH_CHANNELS / WATCH_SUBREDDITS / STANDING_TOPICS below MERGE on top.
THEMES=farcaster,gamestop

# Farcaster (reads via the free, no-auth Warpcast public API by default)
FARCASTER_FID=
# These ADD to whatever the active themes already provide.
WATCH_CHANNELS=
WATCH_FIDS=
STANDING_TOPICS=
# Override the read API base if needed (defaults to https://api.warpcast.com)
FARCASTER_API_BASE=
NEYNAR_API_KEY=
# Optional public Farcaster hub HTTP endpoint - free user-cast fallback (#6).
# Off by default; the 2026 public hubs we tested were unreachable. Drop in a
# live hub URL (NodeRPC / Pinata / self-hosted Snapchain) to enable.
HUB_URL=
# /brief curates from accounts you follow - how many follows to load + rotate through.
BRIEF_SAMPLE_MAX=

# Reddit (free, no-auth public JSON API). Subreddits are a read surface (feed the
# cycle like Farcaster channels); Reddit search is a citable grounding source.
# Reddit grounding is ON by default; the read surfaces only activate when set.
# Set REDDIT_ENABLED=0 to turn Reddit off entirely.
REDDIT_ENABLED=
# Adds to the subreddits the active themes already watch (farcaster + gamestop
# bring farcaster, Superstonk, GME, gamestop).
WATCH_SUBREDDITS=
WATCH_REDDITORS=
# Reddit throttles generic User-Agents - keep a descriptive one.
REDDIT_USER_AGENT=
# Override the read API base if needed (defaults to https://www.reddit.com)
REDDIT_API_BASE=

# Research depth (all free, all default ON). Set to 0 to disable any one:
#   PERSPECTIVES - decompose each topic into market/tech/social angles
#   REFLECT      - after synthesis, fetch sources for the biggest gap, re-synthesize
#   VERIFY       - self-eval findings vs sources, drop contradicted, tag weak
PERSPECTIVES=
REFLECT=
VERIFY=

# Grounding: web search. Leave EXA_API_KEY blank to use free DuckDuckGo.
EXA_API_KEY=

# Bonfire knowledge graph (durable memory)
BONFIRE_API_KEY=
BONFIRE_ID=
BONFIRE_API_URL=https://tnt-v2.api.bonfires.ai

# Delivery
DIGEST_INTERVAL_MS=
