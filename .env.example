# Discord
DISCORD_TOKEN=
DISCORD_USER_ID=

# Models
OPENROUTER_API_KEY=
FREE_MODEL_IDS=openai/gpt-oss-120b:free,z-ai/glm-4.5-air:free,moonshotai/kimi-k2.6:free,nvidia/nemotron-3-super-120b-a12b:free,openai/gpt-oss-20b:free,meta-llama/llama-3.3-70b-instruct:free
OLLAMA_TUNNEL_URL=
OLLAMA_MODEL=llama3.1

# Farcaster (reads via the free, no-auth Warpcast public API by default)
FARCASTER_FID=
WATCH_CHANNELS=zao,dev,miniapps
WATCH_FIDS=
STANDING_TOPICS=farcaster-mini-apps,farcaster-frames-v2,farcaster-snaps
# Override the read API base if needed (defaults to https://api.warpcast.com)
FARCASTER_API_BASE=
NEYNAR_API_KEY=
# Optional public Farcaster hub HTTP endpoint - free user-cast fallback (#6).
# Off by default; the 2026 public hubs we tested were unreachable. Drop in a
# live hub URL (NodeRPC / Pinata / self-hosted Snapchain) to enable.
HUB_URL=
# /brief curates from accounts you follow - how many follows to load + rotate through.
BRIEF_SAMPLE_MAX=

# Research depth (all free, all default ON). Set to 0 to disable any one:
#   PERSPECTIVES - decompose each topic into market/tech/social angles
#   REFLECT      - after synthesis, fetch sources for the biggest gap, re-synthesize
#   VERIFY       - self-eval findings vs sources, drop contradicted, tag weak
PERSPECTIVES=
REFLECT=
VERIFY=

# Grounding: web search. Leave EXA_API_KEY blank to use free DuckDuckGo.
EXA_API_KEY=

# Bonfire knowledge graph (durable memory)
BONFIRE_API_KEY=
BONFIRE_ID=
BONFIRE_API_URL=https://tnt-v2.api.bonfires.ai

# Delivery
DIGEST_INTERVAL_MS=
