{
  "schema": "dreamnet.synergy_capsule.v1",
  "capsule_id": "research-cycle-v1",
  "name": "Farscout Research Cycle",
  "version": "1.0.0",
  "capsule_type": "capability_profile",
  "status": "rehearsed",
  "purpose": "Stateful research cycle with dedup-by-state for farscout Farcaster/Reddit/X discovery, grounding findings in real sources (cast search, web search, token data), and maintaining research state across runs.",
  "payload": {
    "evidence_policy": {
      "citations_required": true,
      "inference_labeled": true,
      "private_sources": "explicit_permission_only"
    },
    "research_config": {
      "perspectives_enabled": true,
      "reflect_enabled": true,
      "verify_enabled": true
    }
  },
  "permissions": {
    "allowed": [
      "artifact.local.write",
      "artifact.local.read",
      "citation.write",
      "research.synthesize",
      "source.local.read",
      "source.public.read",
      "state.persist"
    ],
    "blocked": [
      "cloud.mutate",
      "component.install",
      "connector.unbounded.write",
      "deployment.production.write",
      "package.install",
      "public.publish",
      "secret.value.read",
      "self.modify.live",
      "signer.change",
      "wallet.sign"
    ]
  },
  "resource_limits": {
    "max_wall_time_ms": 600000,
    "max_steps": 40,
    "max_retries_per_step": 2
  },
  "activation": {
    "mode": "manual_review",
    "rollback_version": "disabled"
  },
  "provenance": {
    "source": "https://github.com/BrandonDucar/dreamloops",
    "content_hash": "sha256:e04c87a9e9c630aa554d76be91b8eb23e4c9c28230e61181d88bb2e48b8b54c0"
  }
}
